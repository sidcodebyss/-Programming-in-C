#include <stdio.h>

char* checkLine(int sensor[])
{
    if (sensor[0] == 0 && sensor[1] == 0 &&
        sensor[2] == 1 && sensor[3] == 0 &&
        sensor[4] == 0)
        return "Forward";

    else if (sensor[0] == 1 || sensor[1] == 1)
        return "Left";

    else if (sensor[3] == 1 || sensor[4] == 1)
        return "Right";

    else if (sensor[0] == 0 && sensor[1] == 0 &&
             sensor[2] == 0 && sensor[3] == 0 &&
             sensor[4] == 0)
        return "Stop - Line Lost";

    else if (sensor[0] == 1 && sensor[1] == 1 &&
             sensor[2] == 1 && sensor[3] == 1 &&
             sensor[4] == 1)
        return "Stop - Junction Found";

    else
        return "Forward";
}
