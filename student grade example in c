#include <stdio.h>

void main()
{
    int marks;

    printf("Enter marks: ");
    scanf("%d", &marks);

    if (marks < 40)
    {
        printf("Grade: Fail");
    }
    else if (marks < 60)
    {
        printf("Grade: C");
    }
    else if (marks < 75)
    {
        printf("Grade: B");
    }
    else
    {
        printf("Grade: A");
    }
}
